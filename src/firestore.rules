rules_version = '2';

// Regras do Firestore para o Espetim do Nin.
//
// Como este app não tem login (o painel só usa um PIN visual, que não é
// uma autenticação de verdade), estas regras liberam leitura e escrita
// apenas nas coleções "orders" e "closings" (fechamentos de caixa) — nada
// mais no seu projeto Firebase fica exposto. Isso é adequado para um
// negócio pequeno com baixo risco, mas vale saber: qualquer pessoa que
// inspecionar o código do site consegue ler ou escrever nessas coleções
// também. Se um dia isso virar preocupação, dá para adicionar autenticação
// de verdade (Firebase Auth) — me chame quando quiser evoluir para isso.
//
// Para aplicar: no Firebase Console → Firestore Database → aba "Regras" →
// cole este conteúdo → Publicar.

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /closings/{closingId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}